# OBSOLETE 2026-08-30: old termination flags never worked (runpodctl#330).
# History only. Use config/runpod-core.json and docs/STARTING-PROCEDURE.md.
# Original instructions, no longer executable:
# Copy to an untracked .env.runpod file, then source it from WSL before running
# scripts/start-runpod-model-server.sh. Do not commit credentials or generated values.

# Candidate A is provisional until artifact integrity and the baseline evaluation pass.
VERONICA_MODEL_REPOSITORY=huihui-ai/Huihui-Qwen3-30B-A3B-Instruct-2507-abliterated
VERONICA_MODEL_REVISION=e2f73ec7e99ee316beb8069ca90e4c3cbef8aa0f
VERONICA_MODEL_PATH=/workspace/models/Huihui-Qwen3-30B-A3B-Instruct-2507-abliterated

# Existing persistent volume. The GPU must be available in the same data center.
VERONICA_RUNPOD_VOLUME_ID=v53gj9flzs
VERONICA_RUNPOD_DATA_CENTER=EUR-IS-1
VERONICA_RUNPOD_GPU_ID=NVIDIA A100-SXM4-80GB
VERONICA_RUNPOD_CLOUD_TYPE=SECURE
VERONICA_RUNPOD_CONTAINER_DISK_GB=80

# Required per paid run. Set an ISO-8601 UTC deadline and a price ceiling after approval.
VERONICA_RUNPOD_TERMINATE_AFTER=
VERONICA_RUNPOD_MAX_HOURLY_USD=

# Require an immutable vLLM image digest after it has been qualified with this model.
# Example form only; do not use a tag such as :latest.
VERONICA_VLLM_IMAGE=
VERONICA_VLLM_EXTRA_ARGS=

# Generate a non-empty development key locally. Never commit it or print it.
VERONICA_UPSTREAM_API_KEY=

# Readiness limit for /v1/models after the Pod becomes SSH-reachable.
VERONICA_MODEL_SERVER_TIMEOUT_SECONDS=1200
