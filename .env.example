# Public identity exposed to clients.
VERONICA_PUBLIC_MODEL=Veronica

# OpenAI-compatible provider. Keep real keys only in an uncommitted .env file.
VERONICA_UPSTREAM_BASE_URL=http://127.0.0.1:8000/v1
VERONICA_UPSTREAM_MODEL=huihui-ai/Huihui-Qwen3-30B-A3B-Instruct-2507-abliterated
VERONICA_UPSTREAM_API_KEY=
VERONICA_PROVIDER_TIMEOUT_SECONDS=180

# Local wrapper binding belongs in the start command, not application secrets.
