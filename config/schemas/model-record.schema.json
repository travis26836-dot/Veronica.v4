{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "model-record.schema.json",
  "title": "Veronica installed-foundation registry",
  "description": "Versioned internal provenance registry for the one installed foundation baseline. The public alias never exposes the upstream repository.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "publicAlias",
    "selectionStatus",
    "installedFoundationId",
    "qualificationProtocol",
    "foundation",
    "selectionRule"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "publicAlias": {
      "const": "Veronica.v.4.1-30B-A3B-BF16"
    },
    "selectionStatus": {
      "type": "string",
      "enum": [
        "benchmark_required",
        "hold",
        "qualified",
        "selected",
        "rejected",
        "superseded"
      ]
    },
    "installedFoundationId": {
      "const": "foundation-baseline"
    },
    "qualificationProtocol": {
      "type": "string",
      "minLength": 1
    },
    "foundation": {
      "$ref": "#/$defs/foundationRecord"
    },
    "selectionRule": {
      "type": "string",
      "minLength": 1
    }
  },
  "$defs": {
    "foundationRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "role",
        "repository",
        "revision",
        "storagePath",
        "licenseDeclared",
        "architecture",
        "weightFormat",
        "quantization",
        "weightsModified",
        "provenanceSnapshot",
        "runpodProfile",
        "qualification"
      ],
      "properties": {
        "id": {
          "const": "foundation-baseline"
        },
        "role": {
          "const": "installed_foundation_baseline"
        },
        "repository": {
          "type": "string",
          "pattern": "^[^/\\s]+/[^/\\s]+$"
        },
        "revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "storagePath": {
          "type": "string",
          "minLength": 1
        },
        "licenseDeclared": {
          "type": "string",
          "minLength": 1
        },
        "architecture": {
          "type": "string",
          "minLength": 1
        },
        "weightFormat": {
          "const": "BF16"
        },
        "quantization": {
          "const": "none"
        },
        "weightsModified": {
          "const": false
        },
        "provenanceSnapshot": {
          "type": "string",
          "minLength": 1
        },
        "runpodProfile": {
          "type": "string",
          "minLength": 1
        },
        "qualification": {
          "type": "string",
          "enum": [
            "pending",
            "hold",
            "qualified",
            "selected",
            "rejected",
            "superseded"
          ]
        },
        "notes": {
          "type": "string"
        }
      }
    }
  }
}
