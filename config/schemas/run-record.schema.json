{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "run-record.schema.json",
  "title": "Veronica run record",
  "description": "Canonical run.json written by the immutable run-folder initializer. Extra evidence fields are allowed. Secrets are forbidden.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schemaVersion",
    "runId",
    "recordedAt",
    "owner",
    "stage",
    "status",
    "scope",
    "modelInferencePerformed",
    "paidGpuStarted",
    "weightsModified",
    "modelSelectionStatus",
    "configurationFingerprint",
    "lastDurableHandoff",
    "nextAction"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "runId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
      "description": "Must match the runs/<runId>/ directory name."
    },
    "recordedAt": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "owner": { "type": "string", "minLength": 1 },
    "stage": { "type": "string", "minLength": 1 },
    "status": {
      "type": "string",
      "enum": [
        "intake",
        "validated",
        "hold",
        "ready",
        "in_progress",
        "approval_pending",
        "qualified",
        "selected",
        "rejected",
        "completed",
        "blocked",
        "failed",
        "superseded"
      ]
    },
    "scope": { "type": "string", "minLength": 1 },
    "modelInferencePerformed": { "type": "boolean" },
    "paidGpuStarted": { "type": "boolean" },
    "weightsModified": { "type": "boolean" },
    "modelSelectionStatus": {
      "type": "string",
      "enum": [
        "benchmark_required",
        "hold",
        "qualified",
        "selected",
        "rejected",
        "superseded",
        "not_applicable"
      ]
    },
    "modelRevision": {
      "oneOf": [
        { "type": "null" },
        { "type": "string", "pattern": "^[0-9a-f]{40}$" }
      ]
    },
    "runtimeVersion": { "type": ["string", "null"], "minLength": 1 },
    "gpu": { "type": ["string", "null"], "minLength": 1 },
    "configurationFingerprint": {
      "oneOf": [
        { "type": "null" },
        { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      ]
    },
    "lastDurableHandoff": { "type": "string", "minLength": 1 },
    "nextAction": { "type": "string", "minLength": 1 }
  }
}
